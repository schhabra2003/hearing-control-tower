{
  "name": "hearing-desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hearing Desk: the web app of the fictional hearing coordination case. Builds to one offline HTML file.",
  "scripts": {
    "data": "python3 scripts/export_sheet.py && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export_engine.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export_evidence.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "layout": "node scripts/layout_audit.mjs",
    "smoke": "node scripts/smoke.mjs",
    "engine-check": "node scripts/engine_check.mjs",
    "shoot": "node scripts/shoot.mjs",
    "live": "NODE_USE_ENV_PROXY=1 node --disable-warning=UNDICI-EHPA server/live.mjs",
    "live:recorded": "node server/live.mjs --recorded",
    "live:check": "node server/live-check.mjs",
    "lint": "eslint src",
    "shoot:final": "WIDTHS=1920,390 node scripts/shoot.mjs shots/final dist/index.html all"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@tanstack/react-virtual": "3.14.26",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.77.0",
    "motion": "12.43.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "recharts": "3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.10.3",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
